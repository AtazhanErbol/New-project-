# Пример .env для боевого сервера (VPS).
# Скопируй этот файл в .env на сервере и подставь свои значения.
# Файл .env НЕ коммитится в git (он в .gitignore).

# Длинный случайный ключ. Сгенерировать командой:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

DEBUG=False

# Домены/адреса сайта (через запятую, без пробелов).
#   - Пока нет домена и работаем по IP:   ALLOWED_HOSTS=IP_СЕРВЕРА
#   - Когда домен активен:                ALLOWED_HOSTS=beauty.devbench.shop
ALLOWED_HOSTS=beauty.devbench.shop

# Принудительный HTTPS.
#   - Запуск по IP (без SSL):   SECURE_SSL_REDIRECT=False
#   - С доменом и сертификатом: SECURE_SSL_REDIRECT=True  (или просто убрать эту строку)
SECURE_SSL_REDIRECT=True

# Почта (Gmail). EMAIL_HOST_PASSWORD — это «пароль приложения» Gmail, не обычный пароль.
EMAIL_HOST_USER=твой_gmail@gmail.com
EMAIL_HOST_PASSWORD=пароль_приложения_gmail
ADMIN_EMAIL=твой_gmail@gmail.com

# База данных не указана специально — по умолчанию используется SQLite
# (файл db.sqlite3 в папке проекта). Для небольшого сайта этого достаточно.
